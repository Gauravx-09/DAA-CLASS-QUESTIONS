#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    int n;
    cin >> n;

    int s[100], f[100];

    for (int i = 0; i < n; i++)
        cin >> s[i] >> f[i];

    // Sort activities by finish time
    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (f[i] > f[j]) {
                swap(f[i], f[j]);
                swap(s[i], s[j]);
            }
        }
    }

    cout << "Selected activities: ";

    int lastFinish = -1;

    for (int i = 0; i < n; i++) {
        if (s[i] >= lastFinish) {
            cout << "(" << s[i] << "," << f[i] << ") ";
            lastFinish = f[i];
        }
    }

    return 0;
}
